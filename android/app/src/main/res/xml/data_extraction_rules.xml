<?xml version="1.0" encoding="utf-8"?>
<!-- Les credencials es xifren amb una clau d'Android Keystore que no es copia: restaurades en un altre dispositiu no
     es podrien desxifrar. Es tornen a escriure a Configuració. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/credentials.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/credentials.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
